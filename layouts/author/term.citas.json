{{- $quotes := slice -}}
{{- $currentAuthor := . -}}
{{- $backtick := "`" -}}
{{- $quotePattern := printf `(?s)\{\{<\s*quote\b(?:%s[^%s]*%s|"[^"]*"|[^>])*(?:/quote|/)?\s*>\}\}` $backtick $backtick $backtick -}}
{{- $quotePages := site.RegularPages | append site.Home -}}
{{- range $quotePages -}}
  {{- $page := . -}}
  {{- $content := .RawContent -}}
  {{- $matches := findRE $quotePattern $content -}}
  {{- range $matches -}}
    {{- $quoteTag := . -}}
    {{- $authorRaw := "" -}}
    {{- $authorQuoted := replaceRE `(?s).*author\s*=\s*"([^"]+)".*` "$1" $quoteTag -}}
    {{- if ne $authorQuoted $quoteTag -}}
      {{- $authorRaw = $authorQuoted -}}
    {{- else -}}
      {{- $authorBare := replaceRE `(?s).*author\s*=\s*([^\s>/}]+).*` "$1" $quoteTag -}}
      {{- if ne $authorBare $quoteTag -}}
        {{- $authorRaw = $authorBare -}}
      {{- end -}}
    {{- end -}}
    {{- $authorRaw = $authorRaw | strings.TrimSpace | urlize -}}
    {{- $authorPage := cond (ne $authorRaw "") (site.GetPage (printf "/author/%s" $authorRaw)) nil -}}
    {{- if eq $authorPage $currentAuthor -}}
      {{- $text := "" -}}
      {{- $backtickPattern := printf `(?s).*text\s*=\s*%s([^%s]+)%s.*` $backtick $backtick $backtick -}}
      {{- $textBackticks := replaceRE $backtickPattern "$1" $quoteTag -}}
      {{- if ne $textBackticks $quoteTag -}}
        {{- $text = $textBackticks -}}
      {{- else -}}
        {{- $textQuotes := replaceRE `(?s).*text\s*=\s*"([^"]+)".*` "$1" $quoteTag -}}
        {{- if ne $textQuotes $quoteTag -}}
          {{- $text = $textQuotes -}}
        {{- else -}}
          {{- $inner := replaceRE `(?s).*>\}\}(.*)\{\{<\s*/quote\s*>\}\}` "$1" $quoteTag -}}
          {{- if ne $inner $quoteTag -}}
            {{- $text = $inner -}}
          {{- end -}}
        {{- end -}}
      {{- end -}}

      {{- $dateRaw := replaceRE `(?s).*date\s*=\s*"([^"]+)".*` "$1" $quoteTag -}}
      {{- $date := $page.Date.Format "Jan 2, 2006" -}}
      {{- if ne $dateRaw $quoteTag -}}
        {{- $date = $dateRaw -}}
      {{- end -}}

      {{- if ne ($text | strings.TrimSpace) "" -}}
        {{- $quoteObj := dict "text" ($text | markdownify | plainify | chomp) "source" $page.Permalink "source_title" $page.Title "date" $date -}}
        {{- $quotes = $quotes | append $quoteObj -}}
      {{- end -}}
    {{- end -}}
  {{- end -}}
{{- end -}}
{{- $quotes | jsonify -}}
